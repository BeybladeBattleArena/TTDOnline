rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }

    // Player progression is readable by its owner, but client writes are
    // intentionally blocked. Authoritative writes go through Cloud Functions.
    match /users/{uid} {
      allow read: if owns(uid);
      allow create, update, delete: if false;

      match /{document=**} {
        allow read: if owns(uid);
        allow write: if false;
      }
    }

    // Public-facing summaries and leaderboards will also be backend-written.
    match /publicProfiles/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /leaderboards/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
