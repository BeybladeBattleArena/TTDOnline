rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }

    // Account metadata is readable by its owner, but all writes are backend-only.
    match /users/{uid} {
      allow read: if owns(uid);
      allow create, update, delete: if false;

      // Authoritative progression lives below the player document. Clients do
      // not read or write these documents directly; callable Functions return
      // the safe state required by the game. This keeps future receipts,
      // anti-abuse metadata and server-only fields private by default.
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Public-facing summaries and leaderboards are backend-written.
    match /publicProfiles/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /leaderboards/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
