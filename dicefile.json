  "lore": {
    "soulscimitar": {
      "flavor": "A blade called through a circle that should have stayed closed.",
      "desc": "Summons paired ghostly scimitars from the far edges of the battlefield. They choose targets independently, then grow into additional blades, life-steal, Slow, and piercing attacks as the die classes up."
    },
    "slithervine": {
      "flavor": "A patient root can become a wall. A hungry one grows teeth.",
      "desc": "Targets the fastest enemy, breaking speed ties by current HP. Four destructible vine sections stitch across its route and force enemies to fight through them. Class growth hardens the barrier, adds barbs and control effects, and ultimately leaves surviving sections rooted between casts."
    }
  },
  "design": {
    "soulscimitar": {
      "skills": [{
        "id": "skill1",
        "name": "Soul Scimitar",
        "type": "projectile",
        "damageCategory": "special",
        "affinities": {"arcane": 1.0},
        "cooldown": 4.3,
        "range": "map",
        "targeting": {"mode":"random_with_replacement","baseTargetCount":2,"canMultipleProjectilesChooseSameEnemy":true},
        "spawn": {"pattern":"paired_far_sides","sides":["left","right"]},
        "visual": {
          "summon": "Rotating white alchemical sigil grows from small to roughly twice an average monster, sweeps crimson from the center outward, then restores white while the blade emerges.",
          "projectile": "Off-white translucent ghost scimitar with a crimson demonic eye at the blade/hilt junction and a short crimson trail.",
          "impact": "Blade appears to stab through its true target, dissolves into crimson particles, and the particles drift upward."
        },
        "tiers": {
          "C1": ["Summon 2 blades, one from each far side."],
          "C2": ["Increase damage through normal class damage scaling."],
          "C3": ["Summon 2 additional independently-targeted blades (4 total)."],
          "C4": ["True-target damage restores this die's HP by 25% of damage dealt; flash the casting die crimson."],
          "C5": ["Each true-target hit has a 15% chance to Slow for 2 seconds."],
          "C6": ["Blades pierce overlapping non-target enemies for 30% blade damage; pierced damage cannot heal and does not Slow."],
          "C7": ["Increase damage through normal class damage scaling; summon 2 additional blades (6 total); pierced enemies have a 7% chance to Slow for 2 seconds."]
        }
      }]
    },
    "slithervine": {
      "skills": [{
        "id":"skill1",
        "name":"Slither Vine",
        "type":"melee",
        "damageCategory":"physical",
        "affinities":{"nature":1.0},
        "cooldown":4.84,
        "range":"map",
        "targeting":{"mode":"fastest_then_highest_current_hp","speedUsesCurrentSlowMultiplier":true},
        "spawn":{"pattern":"bottom_center_near_dice_tray","sectionCount":4},
        "visual":{"summon":"Casting die and conjuring point glow green, followed by a small shockwave, dirt spray, and translucent green motes.","travel":"Three serpentine head vines repeatedly dive into and erupt from the ground while leaving four large continuous barrier sections behind them.","impact":"The three heads rear back, hesitate, then lance into the target. The heads remain extended for 1.2 seconds before dissolving; the body normally dissolves backward over 0.8 seconds.","destruction":"Broken sections splatter vine chunks, dirt, and green energy in the direction enemies are pushing through."},
        "barrier":{"sectionBaseHp":"one third of casting die max HP","baseDamageReduction":0.02,"damageReductionExceptions":["fire","ice","metal"],"inheritsCastingDieHp":true,"inheritsDefensiveJewelSupport":true,"brokenBeforeImpactMainDamageMultiplier":0.5},
        "tiers":{"C1":["Basic skill: four destructible body sections and a three-head strike."],"C2":["Reduce base cooldown by 6%."],"C3":["Each section gains 10% HP and +3 percentage points damage reduction."],"C4":["Add yellow-green barbs that deal minor contact damage and slight knockback."],"C5":["Main strike gains 18% damage; barbs gain 35% damage; sections gain 5% HP and +2 percentage points damage reduction."],"C6":["Sections gain a faint yellow-green glow. Main hit has 20% Confusion chance; barb damage has 12% Silence chance; both last 2 seconds before Potency/resistance modifiers."],"C7":["Sections gain 12% HP and +2 percentage points damage reduction. Surviving body sections remain after the heads dissolve and are instantly dissolved when that same die casts again."]}
      }]
    }
  }
