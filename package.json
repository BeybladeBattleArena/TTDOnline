{
  "name": "ttd-online",
  "private": true,
  "scripts": {
    "check": "npm run check:functions && npm run check:client && npm run check:bridge && npm run check:loader",
    "check:functions": "node --check functions/index.js",
    "check:client": "node --input-type=module --check < online/firebase-client-v4.js",
    "check:bridge": "node --check online/game-bridge-inner.js && node --check online/game-loader.js",
    "check:loader": "node scripts/check-online-loader.mjs",
    "emulators": "firebase emulators:start",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy": "firebase deploy"
  },
  "devDependencies": {
    "firebase-tools": "^14.0.0"
  }
}
