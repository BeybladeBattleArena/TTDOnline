{
  "name": "ttd-online",
  "private": true,
  "scripts": {
    "check": "npm run check:functions && npm run check:client",
    "check:functions": "node --check functions/index.js",
    "check:client": "node --input-type=module --check < online/firebase-client.js",
    "emulators": "firebase emulators:start",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy": "firebase deploy"
  },
  "devDependencies": {
    "firebase-tools": "^14.0.0"
  }
}
