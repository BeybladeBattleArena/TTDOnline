{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".github/**",
      ".gitignore",
      "functions/**",
      "scripts/**",
      "node_modules/**",
      "package*.json",
      "firestore.rules",
      "firestore.indexes.json",
      "database.rules.json",
      "README.md",
      "ONLINE-MIGRATION.md"
    ],
    "rewrites": [
      {"source":"/","destination":"/online.html"}
    ],
    "redirects": [
      {"source":"/assets/ui/epic-summon-ticket.webp","destination":"/assets/items/epic-summon-ticket.jpg","type":302},
      {"source":"/assets/ui/exp-tome.webp","destination":"/assets/items/exp-tome.jpg","type":302},
      {"source":"/assets/ui/loading-endless-horde.webp","destination":"/assets/ui/loading-endless-horde.jpg","type":302},
      {"source":"/assets/ui/loading-al-hata.webp","destination":"/assets/ui/loading-al-hata.jpg","type":302},
      {"source":"/assets/items/epic-summon-ticket.webp","destination":"/assets/items/epic-summon-ticket.jpg","type":302},
      {"source":"/assets/items/exp-tome.webp","destination":"/assets/items/exp-tome.jpg","type":302},
      {"source":"/assets/items/key-normal.webp","destination":"/assets/items/key-normal.jpg","type":302},
      {"source":"/assets/items/key-hard.webp","destination":"/assets/items/key-hard.jpg","type":302},
      {"source":"/assets/items/key-hell.webp","destination":"/assets/items/key-hell.jpg","type":302},
      {"source":"/assets/items/mystery-chest.webp","destination":"/assets/items/mystery-chest.jpg","type":302},
      {"source":"/assets/items/chest-frozen-island-normal.webp","destination":"/assets/items/chest-frozen-island-normal.jpg","type":302},
      {"source":"/assets/items/chest-frozen-island-hard.webp","destination":"/assets/items/chest-frozen-island-hard.jpg","type":302},
      {"source":"/assets/items/chest-frozen-island-hell.webp","destination":"/assets/items/chest-frozen-island-hell.jpg","type":302}
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]
      },
      {
        "source": "**/*.svg",
        "headers": [{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]
      },
      {
        "source": "**/*.@(html|js|css|json)",
        "headers": [{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]
      }
    ]
  },
  "firestore": {"rules":"firestore.rules","indexes":"firestore.indexes.json"},
  "functions": [{"source":"functions","codebase":"default","ignore":["node_modules",".git","firebase-debug.log","firebase-debug.*.log"]}],
  "emulators": {
    "auth":{"port":9099},
    "functions":{"port":5001},
    "firestore":{"port":8080},
    "hosting":{"port":5000},
    "ui":{"enabled":true,"port":4000},
    "singleProjectMode":true
  }
}
